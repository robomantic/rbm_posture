<package>
  <name>sr_gui_cyberglove_calibrator</name>
  <version>1.3.0</version>
  <description>A GUI plugin for calibrating cybergloves and similar devices.</description>
  <maintainer email="gwalck@techfak.uni-bielefeld.de">Guillaume Walck</maintainer>

  <license>GPL-2.0-only</license>

  <author email="software@shadowrobot.com">Ugo Cupcic</author>
  <author>Gereon Buescher</author>
  <author>Robomantic</author>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>rqt_gui</build_depend>
  <build_depend>rqt_gui_py</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>

  <run_depend>rospy</run_depend>
  <run_depend>rqt_gui</run_depend>
  <run_depend>rqt_gui_py</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>std_srvs</run_depend>
  <run_depend>cyberglove</run_depend>
  <run_depend>python-scipy</run_depend>
  <run_depend>python3-yaml</run_depend>

  <test_depend>python-mock</test_depend>

<export>
  <rqt_gui plugin="${prefix}/sr_cyberglove_calibrator_plugin.xml" />
  <rqt_gui plugin="${prefix}/sr_cyberglove_tweaker_plugin.xml" />
</export>

</package>
