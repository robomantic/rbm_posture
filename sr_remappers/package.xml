<package>
  <name>sr_remappers</name>
  <version>1.0.0</version>
  <description>Remaps data from and to the Human Hand or a Shadow Hand</description>

  <maintainer email="gwalck@techfak.uni-bielefeld.de">Guillaume Walck</maintainer>
  
  <author email="software@shadowrobot.com">Shadow Robot's software team</author>

